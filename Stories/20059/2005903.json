        "Flag": 2,
        "Type": 0,
        "NextId": 200590371,
        "MessageType": "Text",
        "ImagePath": "",
        "MessageJP": "んーまだ決めてないけど",
        "MessageKR": "으음…… 아직 안 정했는데.",
        "MessageTW": "嗯……我還沒決定耶",
