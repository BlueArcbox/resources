        "Flag": 1,
        "Type": 0,
        "NextId": 101470250,
        "MessageType": "Text",
        "ImagePath": "",
        "MessageJP": "教えてくれて感謝するわ",
        "MessageKR": "알려줘서 고마워",
        "MessageTW": "謝謝你告訴我",
        "MessageEN": "Thank you for teaching me that."
