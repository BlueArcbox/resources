    {
        "MessageId": 101470170,
        "Flag": 2,
        "Type": 3,
        "NextId": 101470180,
        "MessageType": "Text",
        "ImagePath": "",
        "MessageJP": "い、いきなりだね。",
        "MessageKR": "갑자기?",
        "MessageTW": "怎麼突然這麼說？",
        "MessageEN": "Why do you say that?"
    },
    {
        "MessageId": 101470170,
        "Flag": 2,
        "Type": 3,
        "NextId": 101470180,
        "MessageType": "Text",
        "ImagePath": "",
        "MessageJP": "何かあったの？",
        "MessageKR": "무슨 일 있었어?",
        "MessageTW": "發生什麼事了嗎？",
        "MessageEN": "Did something happen?"
    },
    {
        "MessageId": 101470180,
        "Flag": 2,
        "Type": 0,
        "NextId": 101470181,
        "MessageType": "Text",
        "ImagePath": "",
        "MessageJP": "水の中だと息もできないし",
        "MessageKR": "물속에서는 숨도 못 쉬고",
        "MessageTW": "在水裡既無法呼吸",
        "MessageEN": "It's just that you can't breathe underwater"
    },
    {
        "MessageId": 101470181,
        "Flag": 2,
        "Type": 0,
        "NextId": 101470190,
        "MessageType": "Text",
        "ImagePath": "",
        "MessageJP": "自由に動けないわ",
        "MessageKR": "마음대로 움직이지도 못하니까",
        "MessageTW": "也沒辦法隨心所欲地行動",
        "MessageEN": "or move freely."
    },
    {
        "MessageId": 101470190,
        "Flag": 1,
        "Type": 0,
        "NextId": 101470200,
        "MessageType": "Text",
        "ImagePath": "",
        "MessageJP": "もし波にさらわれたりでもしたらと考えると――",
        "MessageKR": "파도에 쓸려가기라도 하면",
        "MessageTW": "要是被海浪捲走的話……",
        "MessageEN": "And if you get swept away by the waves..."
    },
    {
        "MessageId": 101470200,
        "Flag": 2,
        "Type": 3,
        "NextId": 101470210,
        "MessageType": "Text",
        "ImagePath": "",
        "MessageJP": "たしかに、そう思うと怖いね……",
        "MessageKR": "확실히 무서운 일이긴 하지……",
        "MessageTW": "的確是很可怕……",
        "MessageEN": "That IS a scary thought."
    },
    {
        "MessageId": 101470210,
        "Flag": 2,
        "Type": 0,
        "NextId": 101470211,
        "MessageType": "Text",
        "ImagePath": "",
        "MessageJP": "危険なものからは距離を取る",
        "MessageKR": "위험을 멀리하는 것이",
        "MessageTW": "遠離危險",
        "MessageEN": "The smartest thing to do"
